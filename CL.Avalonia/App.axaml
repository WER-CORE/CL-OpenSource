<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:converters="using:CL_CLegendary_Launcher_.Avalonia.Converters"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="CL_CLegendary_Launcher_.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml"/>
        <Style Selector="chrome|WindowDrawnDecorations">
            <Setter Property="Template" Value="{x:Null}" />
        </Style>
        <Style Selector="chrome|WindowDrawnDecorations /template/ Button">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="chrome|WindowDrawnDecorations /template/ Panel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window">
            <Setter Property="Icon" Value="avares://CL.Avalonia/Icon/IconCL(Common).webp" />
            <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckStrokeBorderBrushUnchecked}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckStrokeBorderBrushUncheckedPointerOver}" />
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckStrokeBorderBrushUncheckedPressed}" />
        </Style>
        <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckStrokeBorderBrushUnchecked}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource MainForegroundBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource MainForegroundBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource MainForegroundBrush}" />
        </Style>

        <!-- Уніфіковані поля пошуку та вводу для Light/Dark та кастомних тем -->
        <Style Selector="TextBox.search-input, TextBox.cl-input">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MainForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement, TextBox.cl-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="TextBox.search-input:pointerover /template/ Border#PART_BorderElement, TextBox.cl-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.search-input:focus /template/ Border#PART_BorderElement, TextBox.cl-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.search-input:disabled, TextBox.cl-input:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Спільні стилі ToolTip, ProgressBar та ComboBox -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MainBackgroundBrushServer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ComboBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="ComboBox:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Спільний стиль інтерактивних кнопок із hover/pressed/focus-visible/disabled -->
        <Style Selector="Button.subtle-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.subtle-action /template/ ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
        </Style>
        <Style Selector="Button.subtle-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        </Style>
        <Style Selector="Button.subtle-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
        </Style>
        <Style Selector="Button.subtle-action:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="Button.subtle-action:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button.primary-cta">
            <Setter Property="Background" Value="{DynamicResource MainBackgroundProgressBar}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-cta:focus-visible">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainForegroundBrush}" />
        </Style>
        <Style Selector="Button.primary-cta:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="ToggleSwitch:focus-visible, CheckBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="ListBoxItem:focus-visible">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
        <Style Selector="Border:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource MainBackgroundProgressBar}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CL.Avalonia/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="{x:Type chrome:WindowDrawnDecorations}" TargetType="chrome:WindowDrawnDecorations">
                <Setter Property="Template" Value="{x:Null}" />
            </ControlTheme>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#25FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#EFEFEF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#EFEFEF" />
            <converters:BitmapAssetValueConverter x:Key="BitmapConverter" />
            <converters:IntEqualityConverter x:Key="EqualityConverter" />
            <converters:IntInequalityConverter x:Key="InequalityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
