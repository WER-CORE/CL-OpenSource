<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>CL_CLegendary_Launcher_.Avalonia</RootNamespace>
		<AssemblyName>CL.Avalonia</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<NeutralLanguage>uk-UA</NeutralLanguage>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CL.Core\CL.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="FluentIcons.Avalonia" Version="2.1.337" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="SukiUI" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
	</ItemGroup>

	<!-- Зображення спільні з WPF-клієнтом, тож беремо їх звідти, а не копіюємо. -->
	<ItemGroup>
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\DarkThemBG.png" Link="Assets\Themes\Dark.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\LightThemBG.png" Link="Assets\Themes\Light.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\OceanBG.png" Link="Assets\Themes\Ocean.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\ForestBG.png" Link="Assets\Themes\Forest.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\SunSetBG.png" Link="Assets\Themes\Sunset.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\VanilaVersion.png" Link="Assets\Versions\Release.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\IconOptiFine.png" Link="Assets\Versions\OptiFine.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\DirtIconSnapshot.png" Link="Assets\Versions\Snapshot.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\big-steve-face-2002298922 2.png" Link="Assets\Accounts\Offline.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\LittleSkinAccount.png" Link="Assets\Accounts\LittleSkin.png" />
		<AvaloniaResource Include="..\CL(CLegendary Launcher)\Assets\microsoft logo.png" Link="Assets\Accounts\Microsoft.png" />
	</ItemGroup>

</Project>
