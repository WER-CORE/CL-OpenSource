<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>CL_CLegendary_Launcher_.Avalonia</RootNamespace>
		<AssemblyName>CL.Avalonia</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<NeutralLanguage>uk-UA</NeutralLanguage>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<Version>1.1.0</Version>
		<AssemblyVersion>1.1.0.0</AssemblyVersion>
		<FileVersion>1.1.0.0</FileVersion>
		<InformationalVersion>1.1.0</InformationalVersion>
		<UserSecretsId>CLegendary-Launcher-Secrets-5f3a9e2d</UserSecretsId>
		<ApplicationIcon>Icon\IconCL(Halloween).ico</ApplicationIcon>
	</PropertyGroup>

	<Target Name="CreateLegacyLauncherExeAlias" AfterTargets="Build;Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<Copy SourceFiles="$(TargetDir)CL.Avalonia.exe"
		      DestinationFiles="$(TargetDir)CL(CLegendary Launcher).exe"
		      Condition="Exists('$(TargetDir)CL.Avalonia.exe')"
		      SkipUnchangedFiles="true" />
	</Target>

