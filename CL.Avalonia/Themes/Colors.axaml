<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppFontFamily">Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="GeistFontFamily">avares://CL.Avalonia/Fonts#Geist</FontFamily>
    <FontFamily x:Key="InterFontFamily">Inter, Segoe UI, sans-serif</FontFamily>

    <SolidColorBrush x:Key="MainBackgroundButton">#FF202020</SolidColorBrush>
    <SolidColorBrush x:Key="MainForegroundBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FFFFFFFF" Opacity="0.68" />
    <SolidColorBrush x:Key="MainBackgroundProgressBar">#FF1863C9</SolidColorBrush>
    <SolidColorBrush x:Key="MainBackgroundBrushServer">#FF303030</SolidColorBrush>
    <SolidColorBrush x:Key="MainBorderBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="MainBackgroundBrush">#FF202020</SolidColorBrush>
    <SolidColorBrush x:Key="InputBackgroundBrush">#FF26262A</SolidColorBrush>
    <SolidColorBrush x:Key="InputBorderBrush">#38FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubtleBorderBrush">#26FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubtleHoverBrush">#1AFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubtlePressedBrush">#2BFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ModalScrimBrush">#8C000000</SolidColorBrush>
    <SolidColorBrush x:Key="LinkForegroundBrush">#FF60A5FA</SolidColorBrush>

    <SolidColorBrush x:Key="GlassTintBrush" Color="#202020" Opacity="0.6" />
    <x:Double x:Key="GlassBlurRadius">20.0</x:Double>
    <x:Boolean x:Key="GlassVisibility">True</x:Boolean>

</ResourceDictionary>
