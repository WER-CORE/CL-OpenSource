<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:loc="using:CL_CLegendary_Launcher_.Avalonia.Localization"
        xmlns:vm="using:CL_CLegendary_Launcher_.Avalonia.ViewModels"
        xmlns:views="using:CL_CLegendary_Launcher_.Avalonia.Views"
        x:Class="CL_CLegendary_Launcher_.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CL Launcher"
        Icon="avares://CL.Avalonia/Assets/icon.ico"
        Width="1180" Height="740"
        MinWidth="900" MinHeight="600">

  <suki:SukiWindow.Hosts>
    <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    <suki:SukiToastHost Manager="{Binding ToastManager}" />
  </suki:SukiWindow.Hosts>

  <Grid RowDefinitions="*,Auto">

    <Image Grid.RowSpan="2" Source="{Binding Theme.Background}" Stretch="UniformToFill" IsHitTestVisible="False" />
    <Border Grid.RowSpan="2" Background="{DynamicResource BackdropOverlayBrush}" IsHitTestVisible="False" />

    <suki:SukiSideMenu Grid.Row="0" IsSearchEnabled="False">
      <suki:SukiSideMenu.HeaderContent>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,8,16,16">
          <Image Source="avares://CL.Avalonia/Assets/icon.png" Width="36" Height="36" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CLegendary" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="Launcher" FontSize="12" Opacity="0.7" />
          </StackPanel>
        </StackPanel>
      </suki:SukiSideMenu.HeaderContent>
      <suki:SukiSideMenu.Items>

        <suki:SukiSideMenuItem Header="{loc:Loc Sidebar.Main, Головна}">
          <suki:SukiSideMenuItem.Icon>
            <ic:SymbolIcon Symbol="Home" />
          </suki:SukiSideMenuItem.Icon>
          <suki:SukiSideMenuItem.PageContent>
            <views:HomeView DataContext="{Binding Home}" />
          </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="{loc:Loc Sidebar.Accounts, Акаунти}">
          <suki:SukiSideMenuItem.Icon>
            <ic:SymbolIcon Symbol="Person" />
          </suki:SukiSideMenuItem.Icon>
          <suki:SukiSideMenuItem.PageContent>
            <views:AccountsView DataContext="{Binding Accounts}" />
          </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="{loc:Loc Sidebar.Settings, Налаштування}">
          <suki:SukiSideMenuItem.Icon>
            <ic:SymbolIcon Symbol="Settings" />
          </suki:SukiSideMenuItem.Icon>
          <suki:SukiSideMenuItem.PageContent>
            <views:SettingsView DataContext="{Binding Settings}" />
          </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

      </suki:SukiSideMenu.Items>
    </suki:SukiSideMenu>

    <suki:GlassCard Grid.Row="1" Margin="16,0,16,16" Padding="16,12"
                    IsVisible="{Binding Progress.IsVisible}">
      <Grid ColumnDefinitions="*,16,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Text="{Binding Progress.VersionText}" FontWeight="SemiBold" />
        <ProgressBar Grid.Row="1" Margin="0,6" Value="{Binding Progress.VersionProgress}" Maximum="100" />
        <TextBlock Grid.Row="2" Text="{Binding Progress.FileText}" FontSize="12" Opacity="0.75"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Row="3" Margin="0,6,0,0" Height="4" Value="{Binding Progress.FileProgress}" Maximum="100" />
        <Button Grid.Column="2" Grid.RowSpan="4" VerticalAlignment="Center"
                Content="{loc:Loc Dialogs.BtnCancel, Скасувати}"
                Command="{Binding Progress.CancelCommand}" />
      </Grid>
    </suki:GlassCard>

  </Grid>
</suki:SukiWindow>
