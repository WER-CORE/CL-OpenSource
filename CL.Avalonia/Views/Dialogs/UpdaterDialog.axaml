<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="using:FluentIcons.Avalonia"
        x:Class="CL_CLegendary_Launcher_.Avalonia.Views.Windows.UpdaterWindow"
        Title="CL - Updater"
        Height="450" Width="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent">

    <Window.Styles>
        <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource MainBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#33808080" ClipToBounds="True">
    <Grid>
        <Grid.Background>

            <ImageBrush Source="avares://CL.Avalonia/Assets/Backgrounds/LightThemBG.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" PointerPressed="Header_PointerPressed">
            <Grid Margin="10,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="CL - Оновлення"
                           Foreground="{DynamicResource MainForegroundBrush}"
                           FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Classes="close-btn" Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource MainForegroundBrush}"
                        Width="35" Height="30" Padding="0" Cursor="Hand"
                        CornerRadius="6" ToolTip.Tip="Закрити вікно">
                    <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,20" Opacity="0.95">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border BorderThickness="1" Grid.ColumnSpan="2" Background="{DynamicResource MainBackgroundBrush}" CornerRadius="16"/>

            <Image Height="200" VerticalAlignment="Top" Margin="10,20,10,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">

                <TextBlock x:Name="TxtNewVersion" Text="Доступна нова версія!" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"
                           FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource MainForegroundBrush}"/>

                <TextBlock x:Name="VersionText" Text="Перевірка..." FontSize="16" Margin="0,0,0,20"
                           Foreground="{DynamicResource MainForegroundBrush}" FontFamily="{DynamicResource AppFontFamily}" Opacity="0.8"/>

                <StackPanel x:Name="PathSelectionPanel" Margin="0,0,0,15" IsVisible="False">
                    <TextBlock x:Name="TxtPathSelection" Text="Шлях встановлення:" FontSize="14" Margin="0,0,0,5" Foreground="{DynamicResource MainForegroundBrush}"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox x:Name="PathTextBox" IsReadOnly="True" Height="35" VerticalContentAlignment="Center"
                                 Background="{DynamicResource MainBackgroundBrushServer}" Foreground="{DynamicResource MainForegroundBrush}"
                                 BorderBrush="Transparent" FontFamily="{DynamicResource AppFontFamily}"/>
                        <Button Grid.Column="1" Content="..." Width="40" Height="35" Margin="5,0,0,0" Click="SelectPath_Click"
                                Background="{DynamicResource MainBackgroundButton}" Foreground="{DynamicResource MainForegroundBrush}"/>
                    </Grid>
                </StackPanel>

                <Border Background="{DynamicResource MainBackgroundBrushServer}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,5" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ініціалізація..." HorizontalAlignment="Left" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource MainForegroundBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="SizeText" Text="" HorizontalAlignment="Right" Opacity="0.7" Foreground="{DynamicResource MainForegroundBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="ProgreesBarDowload" Height="6" Value="0" Maximum="100"
                                     Foreground="{DynamicResource MainBackgroundProgressBar}" Background="#33000000"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnUpdate" Content="Завантажити та Встановити"
                        HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsVisible="False" Click="BtnUpdate_Click" Background="{DynamicResource MainBackgroundButton}" Foreground="{DynamicResource MainForegroundBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
