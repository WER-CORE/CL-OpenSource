<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="using:FluentIcons.Avalonia"
        x:Class="CL_CLegendary_Launcher_.Avalonia.Views.Dialogs.MascotDialogWindow"
        Title="MascotDialog" Height="250" Width="500"
        WindowDecorations="None" TransparencyLevelHint="Transparent" TransparencyBackgroundFallback="Transparent" Background="Transparent"
        CanResize="False" WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Window">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border#MainBorder">
            <Style.Animations>
                <Animation Duration="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0,50,0,0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0,0,0,0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="15" Background="{DynamicResource MainBackgroundBrushServer}" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" PointerPressed="MainBorder_PointerPressed">
            <Border.BoxShadow>
                <BoxShadows>0 5 20 0 #80000000</BoxShadows>
            </Border.BoxShadow>

            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="MascotImage" Grid.Column="0"
                       Source=""
                       Stretch="Uniform"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Margin="-20,0,0,-10" Height="200"
                       IsVisible="False"/>

                <Grid Grid.Column="1" Margin="10,20,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleTxt" Text="Заголовок"
                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource MainForegroundBrush}" Margin="0,0,0,10"/>

                    <TextBox x:Name="MessageTxt" Text="Тут буде текст повідомлення від маскота..."
                             FontFamily="{DynamicResource AppFontFamily}" FontSize="14"
                             Foreground="{DynamicResource MainForegroundBrush}" TextWrapping="Wrap"
                             Grid.Row="1" VerticalAlignment="Center" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             SelectionBrush="{DynamicResource MainBackgroundProgressBar}"
                             Height="141" ScrollViewer.VerticalScrollBarVisibility="Visible"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Spacing="15">
                        <Button x:Name="BtnCancel" Content="Ні, чекай"
                                Click="BtnCancel_Click"
                                Width="100" Height="35" Cursor="Hand" Foreground="White">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                                    <Setter Property="Background" Value="{DynamicResource MainBackgroundButton}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <Button x:Name="BtnOK" Content="Зрозуміло"
                                Click="BtnOK_Click"
                                Width="120" Height="35" Cursor="Hand" Foreground="White">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Background">
                                        <LinearGradientBrush EndPoint="0%,100%" StartPoint="0%,0%">
                                            <GradientStop Color="#FF17DA1F" Offset="0"/>
                                            <GradientStop Color="#FF18A61E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush EndPoint="0%,100%" StartPoint="0%,0%">
                                            <GradientStop Color="#E617DA1F" Offset="0"/>
                                            <GradientStop Color="#E618A61E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush EndPoint="0%,100%" StartPoint="0%,0%">
                                            <GradientStop Color="#CC17DA1F" Offset="0"/>
                                            <GradientStop Color="#CC18A61E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Grid>
                <Button Classes="close-btn" Click="BtnCancel_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource MainForegroundBrush}"
                        Width="35" Height="30" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,5,5,0" CornerRadius="6" ToolTip.Tip="Закрити"
                        Grid.ColumnSpan="2">
                    <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
