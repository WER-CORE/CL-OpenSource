<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:pages="clr-namespace:CL_CLegendary_Launcher_.Avalonia.Views.Pages"
             xmlns:controls="using:CL_CLegendary_Launcher_.Avalonia.Views.Controls"
             xmlns:controlsVm="using:CL_CLegendary_Launcher_.Avalonia.ViewModels.Controls"
             xmlns:progRing="using:AvaloniaProgressRing"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="CL_CLegendary_Launcher_.Avalonia.Views.Pages.ModPacksPage"
             x:CompileBindings="False">
    <Grid>
        <Grid x:Name="ListModsBuild"
              Background="Transparent" IsVisible="True">

            <Border IsVisible="{DynamicResource GlassVisibility}">
                <Border.Background>
                    <VisualBrush Visual="{Binding BackgroundVisual, RelativeSource={RelativeSource AncestorType=pages:ModPacksPage}}" Stretch="None" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="{DynamicResource GlassBlurRadius}" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource GlassTintBrush}" />

            <Border Background="{DynamicResource GlassTintBrush}" Opacity="0.6" />

            <Grid Margin="10,10,110,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="108.25" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="FilterGird"
                      Grid.Column="0"
                      Margin="0,0,10,0"
                      IsVisible="False">

                            <Border x:Name="BorderFilter"
                            BorderThickness="1"
                            Background="{DynamicResource MainBackgroundBrushServer}"
                            CornerRadius="12" />

                            <TextBlock x:Name="Loc_TxtModpackFilterTitle" Text="Фільтр Збірок"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource MainForegroundBrush}"
                               FontFamily="Inter 18pt 18pt" />
                        </Grid>

                        <Grid Grid.Column="1"
                      HorizontalAlignment="Center"
                      Width="650"
                      Margin="0,75,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="SearchSystemModsTXT1"
                                     Grid.Row="0"
                                     Height="38"
                                     CornerRadius="8"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource MainForegroundBrush}"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     FontSize="13"
                                     PlaceholderText="Пошук..."
                                     Margin="0,0,0,15"
                                     Text="{Binding ModpackSearchText, Mode=TwoWay}">
                                <TextBox.InnerLeftContent>
                                    <ic:SymbolIcon Symbol="Search" Margin="8,0,4,0" />
                                </TextBox.InnerLeftContent>
                                <TextBox.Styles>
                                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>

                            <Grid Grid.Row="1" Margin="0,0,0,15" Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="BorderFonPackMinecraft"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Grid.ColumnSpan="3"
                                Margin="-4,-4,-6,-4"
                                RenderTransformOrigin="50%,50%"
                                Background="{DynamicResource MainBackgroundBrushServer}"
                                CornerRadius="8">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="-1" />
                                            <SkewTransform />
                                            <RotateTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>

                                <Border x:Name="ImportModPacks"
                                Grid.Column="0"
                                BorderThickness="1"
                                Background="{DynamicResource MainBackgroundButton}"
                                CornerRadius="12"
                                Cursor="Hand"
                                ToolTip.Tip="Натисніть, щоб імпортувати мод-пак збірки"
                                PointerPressed="ImportTXT_MouseDown">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="ArrowDownload"
                                               FontSize="18"
                                               Foreground="{DynamicResource MainForegroundBrush}"
                                               Margin="0,0,8,0" />

                                        <TextBlock x:Name="ImportTXT"
                                           Text="Імпортувати"
                                           FontFamily="Inter 18pt 18pt"
                                           FontSize="16"
                                           Foreground="{DynamicResource MainForegroundBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DowloadModPacks"
                                Grid.Column="2"
                                BorderThickness="1"
                                Background="{DynamicResource MainBackgroundButton}"
                                CornerRadius="12"
                                Cursor="Hand"
                                ToolTip.Tip="Натисніть, щоб створити власну мод-пак збірку"
                                PointerPressed="DowloadModPacks_MouseDown">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Add"
                                               FontSize="18"
                                               Foreground="{DynamicResource MainForegroundBrush}"
                                               Margin="0,0,8,0" />

                                        <TextBlock x:Name="CreateModPacksTXT"
                                           FontFamily="Inter 18pt 18pt"
                                           FontSize="16"
                                           Foreground="{DynamicResource MainForegroundBrush}">
                                    <Run x:Name="Loc_RunCreateNew" Text="Створити нову" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
							<ListBox x:Name="ModsDowloadList1"
                                 Grid.Row="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderBrush="{x:Null}"
                                 BorderThickness="0"
                                 Foreground="White"
                                 ItemsSource="{Binding ModpackCards}">
                                <ListBox.Styles>
                                    <Style Selector="ListBox">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBox /template/ Border#border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBox /template/ ScrollViewer#PART_ScrollViewer">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,6" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="controlsVm:ModpackCardViewModel">
                                        <controls:ModpackCard />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
							</ListBox>
                        </Grid>
                    </Grid>
                </Grid>

        <Grid x:Name="ExportProgressOverlay" ZIndex="1000" IsVisible="{Binding IsExporting}">
            <Border IsVisible="{DynamicResource GlassVisibility}">
                <Border.Background>
                    <VisualBrush Visual="{Binding BackgroundVisual, RelativeSource={RelativeSource AncestorType=pages:ModPacksPage}}" Stretch="None" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="{DynamicResource GlassBlurRadius}" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource GlassTintBrush}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <progRing:ProgressRing IsActive="True" Width="80" Height="80"
                                       Foreground="{DynamicResource MainBackgroundProgressBar}" />

                <TextBlock Text="{Binding ExportProgressText}"
                           Margin="0,20,0,0" FontSize="18" FontFamily="Inter"
                           FontWeight="SemiBold" Foreground="{DynamicResource MainForegroundBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />

                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgressValue}"
                             Width="260" Height="6" CornerRadius="3" Margin="0,15,0,0"
                             Foreground="{DynamicResource MainBackgroundProgressBar}"
                             Background="#33FFFFFF" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
