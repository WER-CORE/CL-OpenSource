<UserControl x:Class="CL_CLegendary_Launcher_.Avalonia.Views.Controls.ModSearchCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:CL_CLegendary_Launcher_.Avalonia.ViewModels.Controls"
             xmlns:fluentIcons="using:FluentIcons.Avalonia"
             x:DataType="vm:ModSearchCardViewModel"
             mc:Ignorable="d"
             Height="40"
             Foreground="{DynamicResource MainForegroundBrush}">
    <Border x:Name="Border" BorderThickness="1"
            Background="{DynamicResource MainBackgroundBrushServer}"
            CornerRadius="8" Margin="0,0,0,5">

        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="IconModPack" Grid.Column="0"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Height="20" Width="20" VerticalAlignment="Center"
                   Source="{Binding Icon}" />

            <TextBlock x:Name="ModPackName" Grid.Column="1"
                       Text="{Binding Name, FallbackValue='Mod Name Example'}"
                       VerticalAlignment="Center" Margin="10,0"
                       FontSize="12" FontFamily="Inter"
                       Foreground="{DynamicResource MainForegroundBrush}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DetailsModPackBtn" Padding="0"
                        Background="Transparent"
                        Width="36" Height="36" Margin="0,0,4,0"
                        Cursor="Hand" Command="{Binding DetailsCommand}">
                    <fluentIcons:SymbolIcon Symbol="Open" FontSize="20" Foreground="{DynamicResource MainForegroundBrush}" />
                </Button>
                <Button x:Name="AddModInModPack" Padding="0"
                        Background="Transparent"
                        Width="36" Height="36"
                        Cursor="Hand" Command="{Binding AddModCommand}">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                          Fill="{DynamicResource MainBackgroundButton}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
