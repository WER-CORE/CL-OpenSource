<UserControl x:Class="CL_CLegendary_Launcher_.Avalonia.Views.Controls.AccountCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CL_CLegendary_Launcher_.Avalonia.ViewModels.Controls"
             x:DataType="vm:AccountCardViewModel"
             Height="50" HorizontalAlignment="Stretch">

    <Border BorderThickness="1"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource MainBackgroundBrushServer}"
            CornerRadius="9"
            ClipToBounds="True">
        <Grid ColumnDefinitions="*,Auto">
            <Button Grid.Column="0"
                    Classes="subtle-action"
                    Command="{Binding SelectCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="6,4"
                    CornerRadius="8"
                    ToolTip.Tip="{Binding NameAccount}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" ClipToBounds="True">
                        <Image Source="{Binding IconBitmap}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding NameAccount}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MainForegroundBrush}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Grid>
            </Button>

            <Button x:Name="DeleteAccountBtn"
                    Grid.Column="1"
                    Classes="subtle-action"
                    Command="{Binding DeleteCommand}"
                    VerticalAlignment="Center"
                    Margin="2,0,6,0"
                    Width="26" Height="26"
                    CornerRadius="6"
                    ToolTip.Tip="Видалити"
                    Padding="5">
                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                      Fill="{DynamicResource MutedForegroundBrush}"
                      Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</UserControl>
