<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>CL.Core.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA2252;CA1416</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CL.Core\CL.Core.csproj" />
    <Compile Include="..\CL.Avalonia\Services\ChannelStrictGithubSource.cs" Link="Velopack\ChannelStrictGithubSource.cs" />
    <Compile Include="..\CL.Avalonia\Services\LauncherUpdateCoordinator.cs" Link="Velopack\LauncherUpdateCoordinator.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\UiNavAction.cs" Link="Gamepad\UiNavAction.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\GamepadSnapshot.cs" Link="Gamepad\GamepadSnapshot.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\IGamepadBackend.cs" Link="Gamepad\IGamepadBackend.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\GamepadRepeatState.cs" Link="Gamepad\GamepadRepeatState.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\FocusScopeStack.cs" Link="Gamepad\FocusScopeStack.cs" />
    <Compile Include="..\CL.Avalonia\Input\Gamepad\GamepadInputGate.cs" Link="Gamepad\GamepadInputGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
