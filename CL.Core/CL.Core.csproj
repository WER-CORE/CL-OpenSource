    <RootNamespace>CL_CLegendary_Launcher_</RootNamespace>
    <AssemblyName>CL.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NeutralLanguage>uk-UA</NeutralLanguage>
