    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Optifine.Installer" Version="1.0.1" />
    <PackageReference Include="Sentry" Version="6.8.0" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

</Project>
